{
  "name": "auto-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "knip": "knip",
    "depcruise": "depcruise modules services --config .dependency-cruiser.cjs --output-type err",
    "links": "lychee --config lychee.toml README.md AGENTS.md CLAUDE.md docs",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm knip && pnpm depcruise && pnpm links"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^16.10.2",
    "knip": "^5.61.3",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2"
}
