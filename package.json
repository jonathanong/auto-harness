{
  "name": "auto-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:web": "rm -rf services/web/.next services/agent-web/.next && pnpm --filter @auto-harness/web build && pnpm --filter @auto-harness/agent-web build",
    "build:web:e2e": "rm -rf services/web/.next-e2e services/agent-web/.next-e2e && pnpm --filter @auto-harness/web build:e2e && pnpm --filter @auto-harness/agent-web build:e2e",
    "test:e2e": "pnpm build:web:e2e && playwright test",
    "test:e2e:ui": "pnpm build:web:e2e && playwright test --ui",
    "knip": "knip",
    "depcruise": "depcruise modules services --config .dependency-cruiser.cjs --output-type err",
    "links": "lychee --config lychee.toml README.md AGENTS.md CLAUDE.md docs",
    "check:data-pw": "no-mistakes check --config .no-mistakes.control.yml; no-mistakes check --config .no-mistakes.agent.yml",
    "check": "pnpm lint && pnpm fmt:check && pnpm test && pnpm knip && pnpm depcruise && pnpm links",
    "local:dynamodb": "docker compose up -d dynamodb",
    "local:dynamodb:ready": "node scripts/ensure-dynamodb.mts",
    "local:dynamodb:down": "docker compose down",
    "local:dynamodb:e2e": "docker compose up -d --force-recreate --renew-anon-volumes dynamodb-e2e",
    "local:dynamodb:e2e:ready": "HARNESS_DDB_ENDPOINT=http://127.0.0.1:7433 node scripts/ensure-dynamodb.mts",
    "local:api": "node services/api/src/cli.ts serve",
    "local:api:e2e": "HARNESS_DDB_ENDPOINT=http://127.0.0.1:7433 node services/api/src/cli.ts serve --port 7430",
    "local:web": "pnpm --filter @auto-harness/web dev",
    "local:web:start": "pnpm --filter @auto-harness/web start",
    "local:web:start:e2e": "pnpm --filter @auto-harness/web start:e2e",
    "local:agent-web": "pnpm --filter @auto-harness/agent-web dev",
    "local:agent-web:start": "pnpm --filter @auto-harness/agent-web start",
    "local:agent-web:start:e2e": "pnpm --filter @auto-harness/agent-web start:e2e",
    "local:agent": "node services/agent/src/cli.ts",
    "local:tmux": "bash scripts/local-tmux.sh",
    "local:ws-e2e": "node scripts/phase3-ws-e2e.mts",
    "local:e2e": "node scripts/local-e2e.mts",
    "local:cli-e2e": "node scripts/local-cli-e2e.mts",
    "local:api-smoke": "node scripts/local-api-smoke.mts",
    "local:cloud-e2e": "node scripts/phase3-cloud-e2e.mts",
    "local:phase2-post": "node scripts/phase2-post-session.mts",
    "local:manage-verify": "node scripts/manage-verify.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^16.10.2",
    "knip": "^5.61.3",
    "no-mistakes": "^0.39.0",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.2"
}
