{
  "name": "auto-harness-client",
  "version": "0.8.1",
  "description": "Dependency-free client for the Auto Harness automation API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/auto-harness.git",
    "directory": "modules/client"
  },
  "bin": {
    "auto-harness": "./src/cli/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./actions": {
      "types": "./src/actions/index.d.ts",
      "import": "./src/actions/index.js"
    },
    "./loopback": {
      "types": "./src/loopback.d.ts",
      "import": "./src/loopback.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}
