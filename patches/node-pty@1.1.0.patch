diff --git a/scripts/prebuild.js b/scripts/prebuild.js
index 17f1d980e62e017d77058627a7a15c4c29f9470c..20ec2ff843eb901885f45f55901ba5975c37e68e 100644
--- a/scripts/prebuild.js
+++ b/scripts/prebuild.js
@@ -31,4 +31,10 @@ if (!fs.existsSync(PREBUILD_DIR)) {
   process.exit(1);
 }
 
+// Package archives can lose the executable bit on the Unix spawn helper.
+// node-pty invokes this file directly, so restore the required mode here.
+if (process.platform !== 'win32') {
+  fs.chmodSync(path.join(PREBUILD_DIR, 'spawn-helper'), 0o755);
+}
+
 process.exit(0);
diff --git a/src/unix/pty.cc b/src/unix/pty.cc
index 7b4b9e1f990fbf95b51528bb56dc9717f5b87532..6beb64fd8e523bdab5f88cb7a310b9ff40357e60 100644
--- a/src/unix/pty.cc
+++ b/src/unix/pty.cc
@@ -167,6 +167,10 @@ void SetupExitCallback(Napi::Env env, Napi::Function cb, pid_t pid) {
         }
       }
     }
+    // Both branches above are done with the kqueue by this point (the
+    // process has exited, or been force-reaped); leaking it here stranded
+    // one fd per pty.fork() call for the lifetime of the host process.
+    close(kq);
 #else
     while (true) {
       errno = 0;
@@ -778,8 +782,21 @@ done:
   posix_spawn_file_actions_destroy(&acts);
   posix_spawnattr_destroy(&attrs);
 
-  for (; count > 0; count--) {
-    close(low_fds[count]);
+  // posix_spawn_file_actions_addclose(&acts, slave) above only closes the
+  // CHILD's inherited copy once it dup2()s slave onto its stdio — it does not
+  // touch this (the parent's) fd. Left unclosed here, one pty slave fd (shown
+  // by `lsof` as `(revoked)` once the pty is later torn down) leaked per spawn.
+  close(slave);
+
+  // The loop above breaks with `count` left at the *index* of the last
+  // opened low fd, so the guard fds actually opened are low_fds[0..count]
+  // inclusive — count+1 of them — unless the loop ran to completion without
+  // ever finding a safe fd, in which case all 3 were opened. A `count > 0`
+  // cleanup loop can never close low_fds[0], and starting from `count == 3`
+  // reads low_fds[3] out of bounds; both leaked one ptmx fd per spawn.
+  size_t opened_low_fds = count < 3 ? count + 1 : 3;
+  for (size_t i = 0; i < opened_low_fds; i++) {
+    close(low_fds[i]);
   }
 }
 #endif
