{
  "name": "@auto-harness/cdk",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "deploy": "node ../../scripts/aws-deployment.mts deploy",
    "update": "node ../../scripts/aws-deployment.mts update",
    "priority-index-status": "node ../../scripts/aws-deployment.mts priority-index-status",
    "priority-index-both": "node ../../scripts/aws-deployment.mts priority-index-both",
    "created-order-index": "node ../../scripts/aws-deployment.mts created-order-index",
    "teardown": "node ../../scripts/aws-deployment.mts teardown",
    "purge": "node ../../scripts/aws-deployment.mts purge",
    "synth": "cdk synth --app 'node src/cli.ts'",
    "diff": "cdk diff --app 'node src/cli.ts'",
    "synth:apigateway-account": "cdk synth --app 'node src/apigateway-account-cli.ts' AutoHarnessApiGatewayAccount"
  },
  "dependencies": {
    "@auto-harness/shared": "workspace:*",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "^2.1140.0"
  }
}
