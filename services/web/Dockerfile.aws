FROM node:22.18.0-bookworm-slim AS builder
WORKDIR /build
RUN corepack enable
COPY . .
RUN pnpm install --filter @auto-harness/web... --frozen-lockfile
ENV HARNESS_WEB_CLOUD=1
RUN pnpm --filter @auto-harness/web build

FROM node:22.18.0-bookworm-slim
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.0 /lambda-adapter /opt/extensions/lambda-adapter
WORKDIR /var/task
COPY --from=builder /build/services/web/.next/standalone ./
COPY --from=builder /build/services/web/.next/static ./services/web/.next/static
ENV AWS_LWA_PORT=8080 NODE_ENV=production PORT=8080
CMD ["node", "services/web/server.js"]
