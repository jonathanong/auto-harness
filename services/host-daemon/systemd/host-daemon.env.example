# Copy to /etc/auto-harness/host-daemon.env with mode 0600. Never commit the
# populated file. systemd EnvironmentFile syntax does not expand shell values.
PATH=/usr/local/bin:/usr/bin:/bin
HARNESS_HOST_ID=REPLACE_WITH_BOUND_HOST_ID
# The CloudFront WebUrl from the deploy output (docs/deploy-aws.md), e.g.
# https://d111111abcdef8.cloudfront.net — never a raw RestApiUrl/WebSocketUrl
# *.execute-api.*.amazonaws.com value; see docs/aws.md.
HARNESS_API_URL=https://REPLACE_WITH_CONTROL_PLANE_URL
HARNESS_API_KEY=REPLACE_WITH_BOUND_SERVICE_ACCOUNT_KEY
HARNESS_CHILD_ENV_ALLOWLIST=
HARNESS_EXECUTION_PROFILES=
HARNESS_MAX_CONCURRENT_ASSIGNMENTS=

# If repository commands need a credential, name it in the allowlist above and
# define it here. HARNESS_* control-plane values are never forwarded.
# GITHUB_TOKEN=REPLACE_WITH_HOST_ONLY_TOKEN
# HARNESS_EXECUTION_PROFILES is an absolute host-local JSON path of per-account CLI homes.
# HARNESS_MAX_CONCURRENT_ASSIGNMENTS optionally overrides the advertised cap.
