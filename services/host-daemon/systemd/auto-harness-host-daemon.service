[Unit]
Description=Auto Harness host daemon
Documentation=https://github.com/jonathanong/auto-harness/blob/main/docs/deploy-host-daemon.md
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=harness
Group=harness
# The wrapper selects HARNESS_UPDATE_INSTALL_DIR/current itself. Keep systemd from
# requiring the default update root when an operator configures another location.
WorkingDirectory=/
EnvironmentFile=/etc/auto-harness/host-daemon.env
# This root-owned verifier consumes only a signed artifact request from the
# daemon-writable incoming/ directory and atomically promotes an immutable
# release before the unprivileged daemon starts.
ExecStartPre=+/usr/bin/env node /usr/local/lib/auto-harness/promote-host-daemon-update.mjs
# Record the replacement's first real boot after promotion and immediately
# before ExecStart. A later unacknowledged launch rolls back in the first phase.
ExecStartPre=+/usr/bin/env node /usr/local/lib/auto-harness/promote-host-daemon-update.mjs --mark-boot-attempt
# install-service (or the manual copy-unit instructions) places this stable
# wrapper outside the atomically activated update tree.
ExecStart=/bin/sh "/usr/local/lib/auto-harness/run-host-daemon.sh"
# systemd runs this root-owned confirmation only after the main daemon has
# sent READY=1 following the control-plane registration barrier.
ExecStartPost=+/usr/bin/env node /usr/local/lib/auto-harness/promote-host-daemon-update.mjs --confirm-ready
Restart=always
RestartSec=5s
TimeoutStopSec=15min
KillMode=mixed
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
