{
  "name": "@auto-harness/host-pane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node ../../scripts/validate-bind.mts HARNESS_HOST_PANE_HOST && next dev --hostname ${HARNESS_HOST_PANE_HOST:-127.0.0.1} --port 7422",
    "build": "next build",
    "build:e2e": "HARNESS_E2E=1 HARNESS_API_HTTP=${HARNESS_API_HTTP:-http://127.0.0.1:7430} next build",
    "start": "node ../../scripts/validate-bind.mts HARNESS_HOST_PANE_HOST && next start --hostname ${HARNESS_HOST_PANE_HOST:-127.0.0.1} --port 7422",
    "start:e2e": "HARNESS_E2E=1 HARNESS_API_HTTP=http://127.0.0.1:7430 next start --port 7432"
  },
  "dependencies": {
    "@auto-harness/shared": "workspace:*",
    "@auto-harness/ui": "workspace:*",
    "next": "^15.5.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
