{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/local-e2e.mts",
        "scripts/local-api-smoke.mts",
        "scripts/local-cli-e2e.mts",
        "scripts/phase3-cloud-e2e.mts",
        "scripts/phase2-post-session.mts",
        "scripts/ensure-dynamodb.mts",
        "vitest.config.ts",
      ],
      "project": ["scripts/**/*.{ts,mts}", "vitest.config.ts"],
    },
    "modules/shared": {
      "project": ["src/**/*.ts"],
    },
    "services/api": {
      "entry": ["src/index.ts", "src/cli.ts"],
      "project": ["src/**/*.ts"],
    },
    "services/agent": {
      "entry": ["src/index.ts", "src/cli.ts"],
      "project": ["src/**/*.ts"],
    },
    "services/web": {
      "project": ["src/**/*.ts"],
    },
    "services/cdk": {
      "project": ["src/**/*.ts"],
    },
  },
  "ignoreBinaries": ["lychee"],
}
