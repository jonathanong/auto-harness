{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mts"],
      "project": ["scripts/**/*.{ts,mts}", "e2e/**/*.ts"],
    },
    "actions/dispatch": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "modules/shared": {
      "project": ["src/**/*.ts"],
    },
    "modules/ui": {
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "services/api": {
      "project": ["src/**/*.ts"],
    },
    "services/host-daemon": {
      "project": ["src/**/*.ts"],
    },
    "services/web": {
      "entry": ["src/index.ts", "src/app/**/page.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "services/host-pane": {
      "entry": ["src/index.ts", "src/app/**/page.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "services/cdk": {
      "entry": ["src/cli.ts", "src/apigateway-account-cli.ts"],
      "project": ["src/**/*.ts"],
    },
  },
  "ignore": ["**/*-test-helpers.ts"],
  "ignoreBinaries": ["lychee", "systemd-analyze"],
}
