{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/local-e2e.mts",
        "scripts/local-api-smoke.mts",
        "scripts/local-cli-e2e.mts",
        "scripts/phase3-cloud-e2e.mts",
        "scripts/phase2-post-session.mts",
        "scripts/ensure-dynamodb.mts",
        "scripts/phase3-ws-e2e.mts",
        "scripts/manage-verify.mts",
        "vitest.config.ts",
        "playwright.config.ts",
      ],
      "project": [
        "scripts/**/*.{ts,mts}",
        "vitest.config.ts",
        "playwright.config.ts",
        "e2e/**/*.ts",
      ],
    },
    "modules/shared": {
      "project": ["src/**/*.ts"],
    },
    "modules/ui": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "services/api": {
      "entry": ["src/index.ts", "src/cli.ts"],
      "project": ["src/**/*.ts"],
    },
    "services/agent": {
      "entry": ["src/index.ts", "src/cli.ts"],
      "project": ["src/**/*.ts"],
    },
    "services/web": {
      "entry": ["src/index.ts", "src/app/**/page.tsx", "src/app/layout.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "services/agent-web": {
      "entry": ["src/index.ts", "src/app/**/page.tsx", "src/app/layout.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "services/cdk": {
      "project": ["src/**/*.ts"],
    },
  },
  "ignore": ["**/*-test-helpers.ts", "**/.next/**", "**/next-env.d.ts", "**/next.config.ts"],
  "ignoreBinaries": ["lychee", "playwright"],
  "ignoreDependencies": ["autoprefixer", "postcss", "tailwindcss", "next", "react", "react-dom"],
}
